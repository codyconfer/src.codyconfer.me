{
  "name": "src.codyconfer.me",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lmnt-dev": "pnpm --dir lmnt run dev",
    "lmnt-pkg": "pnpm --dir lmnt install && pnpm --dir lmnt run build && node build/submodules.js",
    "dev": "pnpm --dir lmnt run build && node build/submodules.js && eleventy --serve",
    "serve": "eleventy --serve",
    "build": "eleventy",
    "pkg": "pnpm run lmnt-pkg && eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/font-awesome": "^1.0.1",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "lit": "^3.3.3",
    "lit-html": "^3.3.3",
    "markdown-it": "^14.3.0",
    "markdown-it-attrs": "^5.0.1",
    "terser": "^5.49.0"
  },
  "license": "MIT",
  "repository": "https://github.com/codyconfer/src.codyconfer.me.git",
  "include": [
    "src/**/*"
  ]
}
